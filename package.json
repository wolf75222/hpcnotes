{
  "name": "hpcnotes",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "node scripts/copy-mermaid.mjs && node scripts/optimize-media.mjs",
    "prebuild": "node scripts/copy-mermaid.mjs && node scripts/optimize-media.mjs",
    "postinstall": "node scripts/copy-mermaid.mjs",
    "dev": "next dev --port 43123 --hostname 127.0.0.1",
    "build": "next build",
    "start": "npx --yes wrangler@4 pages dev out --port 43123",
    "new": "node scripts/new-note.mjs",
    "lint": "eslint .",
    "astryx": "node node_modules/@astryxdesign/cli/clients/cli/bin/astryx.mjs",
    "dev:lan": "next dev --port 43123 --hostname 0.0.0.0",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run lint && npm run typecheck && npm test",
    "postbuild": "node scripts/postbuild.mjs"
  },
  "dependencies": {
    "@astryxdesign/cli": "^0.5.2",
    "@astryxdesign/core": "^0.5.2",
    "@astryxdesign/theme-neutral": "^0.5.2",
    "@giscus/react": "^3.1.0",
    "@stylexjs/stylex": "^0.19.0",
    "katex": "^0.19.1",
    "mermaid": "^12.3.0",
    "next": "^16.4.5",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "^16.4.5",
    "sharp": "^0.35.5",
    "typescript": "^5",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": ">=20.9"
  },
  "overrides": {
    "@typescript-eslint/typescript-estree": {
      "minimatch": "^11.0.5"
    },
    "mermaid": {
      "katex": "$katex"
    }
  }
}
