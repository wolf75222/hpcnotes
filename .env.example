# Google AdSense. Leave blank to hide ad regions entirely.
NEXT_PUBLIC_ADSENSE_CLIENT=
NEXT_PUBLIC_ADSENSE_SLOT_INFEED=
NEXT_PUBLIC_ADSENSE_SLOT_ARTICLE=

# Public origin for /feed.xml, sitemap, and Open Graph URLs. Defaults to https://hpcnotes.eu
NEXT_PUBLIC_SITE_URL=https://hpcnotes.eu

# Optional Google Search Console HTML-tag verification code
GOOGLE_SITE_VERIFICATION=
